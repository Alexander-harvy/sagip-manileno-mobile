<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/sagip_navy"
            android:gravity="center"
            android:text="SAGIP MANILEÑO"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/sagip_dark_text"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="REPORT INCIDENT"
                android:textColor="@color/sagip_dark_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvIncidentType"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@color/sagip_gray"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="INCIDENT TYPE: NOT SELECTED"
                    android:textColor="@color/sagip_dark_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnChangeType"
                    android:layout_width="90dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/sagip_blue"
                    android:text="Change"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="40dp"
                android:background="@color/sagip_gray"
                android:gravity="top"
                android:hint="DESCRIPTION"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:padding="16dp"
                android:textColor="@color/sagip_dark_text"
                android:textColorHint="@color/sagip_dark_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGpsStatus"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="36dp"
                android:background="@color/sagip_gray"
                android:gravity="center"
                android:text="GPS CHECKING..."
                android:textColor="@color/sagip_dark_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSos"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="60dp"
                android:backgroundTint="@color/sagip_red"
                android:text="SOS"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="HOLD TO SEND"
                android:textColor="@color/sagip_dark_text"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>